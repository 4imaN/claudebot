TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# Claude: "cli" uses your locally logged-in `claude` (Claude Code). "api" uses ANTHROPIC_API_KEY.
CLAUDE_BACKEND=cli
CLAUDE_MODEL=
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TOOLS=
CLAUDE_CLI_ALLOW_MCP=false
CLAUDE_CLI_TIMEOUT_MS=300000

ANTHROPIC_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Claude Code sessions (/sessions, /new). Only enabled when ALLOWED_USER_IDS is set.
CLAUDE_CODE_PERMISSION_MODE=auto
CLAUDE_CODE_DEFAULT_DIR=~
CLAUDE_CODE_TIMEOUT_MS=1800000
